# CDN Configuration
# Set CDN_URL to enable CDN integration
# Example: CDN_URL=https://your-cdn-domain.com
CDN_URL=

# Environment
NODE_ENV=development

# Server Configuration
PORT=3000

# Session Configuration
# Session time-to-live in milliseconds (default: 24 hours)
SESSION_TTL_MS=86400000

# Demo Users Configuration
# These are configured in .env.config.js
# Admin: username=admin, password=demo1234
# Staff: username=staffnurse, password=demo1234
# Family: username=henderson, password=demo1234