{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "pages/**",
          "css/**",
          "js/**",
          "hero imgs/**",
          "*.jpg",
          "*.png",
          "*.svg",
          "db.json",
          "404.html",
          ".env.config",
          "backend/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
