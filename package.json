{
  "name": "lumina-hotel-management",
  "version": "1.0.0",
  "description": "Lumina Hospitality Hotel Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "npm run build:tailwind && webpack --mode production",
    "build:dev": "webpack --mode development --watch",
    "build:tailwind": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind-output.css --minify",
    "build:tailwind:dev": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind-output.css --watch",
    "analyze": "webpack --mode production --profile --json > stats.json && webpack-bundle-analyzer stats.json",
    "clean": "rimraf dist",
    "prebuild": "npm run clean && npm run build:tailwind",
    "postbuild": "node scripts/copy-dist.js"
  },
  "keywords": [
    "hotel-management",
    "performance-optimization"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.0.3",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.9",
    "autoprefixer": "^10.4.14",
    "babel-loader": "^9.1.2",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^6.8.0",
    "css-minimizer-webpack-plugin": "^5.0.0",
    "html-webpack-plugin": "^5.5.3",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.4.24",
    "postcss-loader": "^7.3.0",
    "rimraf": "^5.0.1",
    "style-loader": "^3.3.3",
    "tailwindcss": "^3.3.2",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "^5.88.0",
    "webpack-bundle-analyzer": "^4.9.0",
    "webpack-cli": "^5.1.4"
  }
}